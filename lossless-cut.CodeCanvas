			"path": "e52b3a49-fe56-41fb-a33b-f383ea1f2784",
			"cellName": "Smart Cut Export Flow: Enable Smart Cut in Export Dialog - ExportConfirm.tsx:L537-545",
			"cellId": "e52b3a49-fe56-41fb-a33b-f383ea1f2784",
			"visible": true,
			"parentCellId": "2183141b-ec7d-4cd7-b845-6770f4a763d3"
		},
		"src/renderer/src/components/ExportConfirm.tsx-simstep-6f055092-fd05-4352-9217-149714ffd3c4": {
			"path": "src/renderer/src/components/ExportConfirm.tsx-simstep-6f055092-fd05-4352-9217-149714ffd3c4",
			"fileName": "ExportConfirm.tsx",
			"wiki": "The user initiates an export, and in the export confirmation dialog, they enable the 'Smart cut (experimental)' option. This setting informs the application to use the frame-accurate cutting strategy instead of the default keyframe-based cut.",
			"cellName": "Smart Cut Export Flow: Enable Smart Cut in Export Dialog - ExportConfirm.tsx:L537-545",
			"cellId": "e52b3a49-fe56-41fb-a33b-f383ea1f2784",
			"visible": true,
			"startLine": 537,
			"endLine": 545,
			"parentCellId": "2183141b-ec7d-4cd7-b845-6770f4a763d3",
			"parentPath": "src/renderer/src/components/ExportConfirm.tsx",
			"simSteps": [
				{
					"simulationKey": "Smart Cut for frame-accurate lossless cutting",
					"simStepId": "6f055092-fd05-4352-9217-149714ffd3c4"
				}
			]
		},
		"cd27e4c5-1af8-44c8-9dea-f76a3e12c56d": {
			"path": "cd27e4c5-1af8-44c8-9dea-f76a3e12c56d",
			"cellName": "Smart Cut Export Flow: Analyze Keyframes to Determine Necessity of Smart Cut - smartcut.ts:L9-25",
			"cellId": "cd27e4c5-1af8-44c8-9dea-f76a3e12c56d",
			"visible": true,
			"parentCellId": "7cd96696-e85a-46eb-a87f-063bed1df278"
		},
		"src/renderer/src/smartcut.ts-simstep-f95a44e1-100e-40bd-a7a5-e307fba3426a": {
			"path": "src/renderer/src/smartcut.ts-simstep-f95a44e1-100e-40bd-a7a5-e307fba3426a",
			"fileName": "smartcut.ts",
			"wiki": "For the given video file and the desired cut-from time, the system analyzes the video's keyframes. It determines if the cut point is on a keyframe or not. If not, it identifies the next keyframe to calculate the segment that needs re-encoding.",
			"cellName": "Smart Cut Export Flow: Analyze Keyframes to Determine Necessity of Smart Cut - smartcut.ts:L9-25",
			"cellId": "cd27e4c5-1af8-44c8-9dea-f76a3e12c56d",
			"visible": true,
			"startLine": 9,
			"endLine": 25,
			"parentCellId": "7cd96696-e85a-46eb-a87f-063bed1df278",
			"parentPath": "src/renderer/src/smartcut.ts",
			"simSteps": [
				{
					"simulationKey": "Smart Cut for frame-accurate lossless cutting",
					"simStepId": "f95a44e1-100e-40bd-a7a5-e307fba3426a"
				}
			]
		},
		"33eaa9b9-8bba-4ef5-b2e0-e550ca314def": {
			"path": "33eaa9b9-8bba-4ef5-b2e0-e550ca314def",
			"cellName": "Smart Cut Export Flow: Re-encode Initial 'Smart' Part - useFfmpegOperations.ts:L633",
			"cellId": "33eaa9b9-8bba-4ef5-b2e0-e550ca314def",
			"visible": true,
			"parentCellId": "91be0fbc-dd89-401a-955e-973d0cd39b7c"
		},
		"src/renderer/src/hooks/useFfmpegOperations.ts-simstep-f8cbc62f-2379-419f-86c6-87b6bd9576e3": {
			"path": "src/renderer/src/hooks/useFfmpegOperations.ts-simstep-f8cbc62f-2379-419f-86c6-87b6bd9576e3",
			"fileName": "useFfmpegOperations.ts",
			"wiki": "A temporary video file is created by re-encoding the small portion of the video from the desired cut point to the next keyframe (minus one frame). This creates a new video segment that starts exactly where the user specified.",
			"cellName": "Smart Cut Export Flow: Re-encode Initial 'Smart' Part - useFfmpegOperations.ts:L633",
			"cellId": "33eaa9b9-8bba-4ef5-b2e0-e550ca314def",
			"visible": true,
			"startLine": 633,
			"endLine": 633,
			"parentCellId": "91be0fbc-dd89-401a-955e-973d0cd39b7c",
			"parentPath": "src/renderer/src/hooks/useFfmpegOperations.ts",
			"simSteps": [
				{
					"simulationKey": "Smart Cut for frame-accurate lossless cutting",
					"simStepId": "f8cbc62f-2379-419f-86c6-87b6bd9576e3"
				}
			]
		},
		"055c17d0-6a17-4110-a72a-cfb086a41b48": {
			"path": "055c17d0-6a17-4110-a72a-cfb086a41b48",
			"cellName": "Smart Cut Export Flow: Losslessly Cut Remaining 'Lossless' Part - useFfmpegOperations.ts:L617-620",
			"cellId": "055c17d0-6a17-4110-a72a-cfb086a41b48",
			"visible": true,
			"parentCellId": "91be0fbc-dd89-401a-955e-973d0cd39b7c"
		},
		"src/renderer/src/hooks/useFfmpegOperations.ts-simstep-24287a8e-add7-4e4f-b90b-a0a9e2df2f9e": {
			"path": "src/renderer/src/hooks/useFfmpegOperations.ts-simstep-24287a8e-add7-4e4f-b90b-a0a9e2df2f9e",
			"fileName": "useFfmpegOperations.ts",
			"wiki": "The main, larger portion of the video segment, starting from the keyframe, is cut losslessly. This is a very fast operation as it involves no re-encoding, just copying data.",
			"cellName": "Smart Cut Export Flow: Losslessly Cut Remaining 'Lossless' Part - useFfmpegOperations.ts:L617-620",
			"cellId": "055c17d0-6a17-4110-a72a-cfb086a41b48",
			"visible": true,
			"startLine": 617,
			"endLine": 620,
			"parentCellId": "91be0fbc-dd89-401a-955e-973d0cd39b7c",
			"parentPath": "src/renderer/src/hooks/useFfmpegOperations.ts",
			"simSteps": [
				{
					"simulationKey": "Smart Cut for frame-accurate lossless cutting",
					"simStepId": "24287a8e-add7-4e4f-b90b-a0a9e2df2f9e"
				}
			]
		},
		"cafa286a-9197-4971-bdc0-34ecaf73d961": {
			"path": "cafa286a-9197-4971-bdc0-34ecaf73d961",
			"cellName": "Smart Cut Export Flow: Concatenate Smart and Lossless Parts - useFfmpegOperations.ts:L638-640",
			"cellId": "cafa286a-9197-4971-bdc0-34ecaf73d961",
			"visible": true,
			"parentCellId": "91be0fbc-dd89-401a-955e-973d0cd39b7c"
		},
		"src/renderer/src/hooks/useFfmpegOperations.ts-simstep-e9a7b973-1a32-43be-a3ee-adc8290af84f": {
			"path": "src/renderer/src/hooks/useFfmpegOperations.ts-simstep-e9a7b973-1a32-43be-a3ee-adc8290af84f",
			"fileName": "useFfmpegOperations.ts",
			"wiki": "The re-encoded 'smart' part and the 'lossless' part are concatenated into a single, seamless video file. This final file has the exact start time the user requested while retaining the original quality for the majority of its duration.",
			"cellName": "Smart Cut Export Flow: Concatenate Smart and Lossless Parts - useFfmpegOperations.ts:L638-640",
			"cellId": "cafa286a-9197-4971-bdc0-34ecaf73d961",
			"visible": true,
			"startLine": 638,
			"endLine": 640,
			"parentCellId": "91be0fbc-dd89-401a-955e-973d0cd39b7c",
			"parentPath": "src/renderer/src/hooks/useFfmpegOperations.ts",
			"simSteps": [
				{
					"simulationKey": "Smart Cut for frame-accurate lossless cutting",
					"simStepId": "e9a7b973-1a32-43be-a3ee-adc8290af84f"
				}
			]
		},
		"71364934-4d5f-4b50-a40d-fa048e763548": {
			"path": "71364934-4d5f-4b50-a40d-fa048e763548",
			"cellName": "Smart Cut Export Flow: Clean Up Temporary Files - useFfmpegOperations.ts:L641-643",
			"cellId": "71364934-4d5f-4b50-a40d-fa048e763548",
