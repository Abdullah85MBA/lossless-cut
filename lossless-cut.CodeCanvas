			"path": "src/renderer/src/hooks/useFfmpegOperations.ts-simstep-79ea4dee-ac93-4895-a6ac-837bd535a392",
			"fileName": "useFfmpegOperations.ts",
			"wiki": "After the final file has been created, the temporary encoded and lossless parts are deleted from the filesystem to free up space.",
