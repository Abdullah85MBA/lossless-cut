					"diagramNodeId": "a0728d5e-2213-4854-80e3-7115cfc90796",
					"simStepLabel": "Prepare for IPC Call",
					"simStepDescription": "The 'captureFrameFromFfmpeg' function inside the 'useFrameCapture' hook prepares the arguments for the main process. It determines the final output path for the image file and invokes the 'ffmpeg.captureFrame' function, which will send the request to the main process.",
					"isEdge": 0,
					"sourceCodeMapping": {
