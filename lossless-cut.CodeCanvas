						]
					},
					"inputDataExample": "{\"outPath\": \"/Users/jane/Pictures/snapshots/project_alpha-snapshot.jpeg\"}",
					"outputDataExample": "{\"outPath\": \"/Users/jane/Pictures/snapshots/project_alpha-snapshot.jpeg\"}"
				},
				{
					"simStepId": "42e5fc57-fda3-4a5c-8fcc-37110ed9c14a",
					"diagramNodeId": "3c6ff930-2d54-45be-b31d-ae0b72ffc771",
					"simStepLabel": "Display Success Notification",
					"simStepDescription": "Back in the renderer process, the 'captureSnapshot' function's async call resolves with the output path. It then displays a native OS notification and an in-app toast message to inform the user of the successful capture, and finally resets the UI from its 'working' state.",
					"isEdge": 0,
					"sourceCodeMapping": {
