					"diagramNodeId": "0d3ba958-ca4c-4d81-ba6d-9e166ebb3141",
					"simStepLabel": "User Initiates Metadata Editing",
					"simStepDescription": "The user clicks the 'Edit file metadata' icon button in the StreamsSelector component to open the metadata editor dialog for the currently loaded media file.",
