					},
					"inputDataExample": "{\"filePath\": \"/path/to/media/file.mp4\", \"customTagsByFile\": {\"/path/to/media/file.mp4\": {\"title\": \"My Custom Title\", \"comment\": \"A new comment\"}}, \"streams\": [{\"index\": 0, \"codec_type\": \"video\"}]}",
					"outputDataExample": "{\"ffmpeg_args\": [\"-metadata\", \"title=My Custom Title\", \"-metadata\", \"comment=A new comment\"]}"
				},
