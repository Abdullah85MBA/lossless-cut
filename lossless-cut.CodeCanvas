					"simStepLabel": "Smart Cut Export Flow: Enable Smart Cut in Export Dialog",
					"simStepDescription": "The user initiates an export, and in the export confirmation dialog, they enable the 'Smart cut (experimental)' option. This setting informs the application to use the frame-accurate cutting strategy instead of the default keyframe-based cut.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/renderer/src/components/ExportConfirm.tsx",
						"startLine": "537",
						"endLine": "545",
						"relevantVariables": [
							"enableSmartCut",
							"setEnableSmartCut",
							"Switch"
						]
					},
					"inputDataExample": "{\"areWeCutting\": true, \"needSmartCut\": true, \"enableSmartCut\": false}",
					"outputDataExample": "{\"areWeCutting\": true, \"needSmartCut\": true, \"enableSmartCut\": true}"
				},
				{
					"simStepId": "807bfa92-2737-4984-a396-8502bdbbbeab",
					"diagramNodeId": "4601b430-0504-4ef2-88c9-2d8bc8694e91",
					"simStepLabel": "Smart Cut Export Flow: Pass Export Configuration",
					"simStepDescription": "The export configuration, including the enabled 'enableSmartCut' flag and segment data, is passed from the UI component to the `useFfmpegOperations` hook, which orchestrates the cutting process.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/renderer/src/hooks/useFfmpegOperations.ts",
						"startLine": "592",
						"endLine": "592",
						"relevantVariables": [
							"cutSegment"
						]
					},
					"inputDataExample": "{\"segments\": [{\"cutFrom\": 10.5, \"cutTo\": 25.0}], \"customOutDir\": \"/path/to/output\", \"outFormat\": \"mp4\", \"enableSmartCut\": true}",
					"outputDataExample": "{\"segments\": [{\"cutFrom\": 10.5, \"cutTo\": 25.0}], \"customOutDir\": \"/path/to/output\", \"outFormat\": \"mp4\", \"enableSmartCut\": true}"
				},
				{
					"simStepId": "f95a44e1-100e-40bd-a7a5-e307fba3426a",
					"diagramNodeId": "cd27e4c5-1af8-44c8-9dea-f76a3e12c56d",
					"simStepLabel": "Smart Cut Export Flow: Analyze Keyframes to Determine Necessity of Smart Cut",
					"simStepDescription": "For the given video file and the desired cut-from time, the system analyzes the video's keyframes. It determines if the cut point is on a keyframe or not. If not, it identifies the next keyframe to calculate the segment that needs re-encoding.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/renderer/src/smartcut.ts",
						"startLine": "9",
						"endLine": "25",
						"relevantVariables": [
							"needsSmartCut",
							"readKeyframesAroundTime",
							"findKeyframeAtExactTime",
							"findNextKeyframe"
						]
					},
					"inputDataExample": "{\"path\": \"/path/to/source/video.mp4\", \"desiredCutFrom\": 10.5, \"videoStream\": {\"index\": 0}}",
					"outputDataExample": "{\"losslessCutFrom\": 12.0, \"segmentNeedsSmartCut\": true}"
				},
				{
					"simStepId": "d22123fe-f2be-4d8a-85ae-2040de0ebc8f",
					"diagramNodeId": "6a7cbb67-d1b6-4e3e-82b5-cbfb4dfd8798",
					"simStepLabel": "Smart Cut Export Flow: Transmit Smart Cut Analysis Result",
					"simStepDescription": "The result of the keyframe analysis, indicating whether a smart cut is needed and the timestamp of the next keyframe, is passed back to the main cutting logic within the `cutSegment` function.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/renderer/src/hooks/useFfmpegOperations.ts",
						"startLine": "593",
						"endLine": "593",
						"relevantVariables": [
							"losslessCutFrom",
							"segmentNeedsSmartCut"
						]
					},
					"inputDataExample": "{\"losslessCutFrom\": 12.0, \"segmentNeedsSmartCut\": true}",
					"outputDataExample": "{\"losslessCutFrom\": 12.0, \"segmentNeedsSmartCut\": true}"
				},
				{
					"simStepId": "f8cbc62f-2379-419f-86c6-87b6bd9576e3",
					"diagramNodeId": "33eaa9b9-8bba-4ef5-b2e0-e550ca314def",
					"simStepLabel": "Smart Cut Export Flow: Re-encode Initial 'Smart' Part",
					"simStepDescription": "A temporary video file is created by re-encoding the small portion of the video from the desired cut point to the next keyframe (minus one frame). This creates a new video segment that starts exactly where the user specified.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/renderer/src/hooks/useFfmpegOperations.ts",
						"startLine": "633",
						"endLine": "633",
						"relevantVariables": [
							"cutEncodeSmartPartWrapper",
							"desiredCutFrom",
							"encodeCutToSafe",
							"smartCutEncodedPartOutPath"
						]
					},
					"inputDataExample": "{\"cutFrom\": 10.5, \"cutTo\": 11.96, \"outPath\": \"/tmp/smartcut-segment-encode-0.mp4\", \"videoCodec\": \"h264\", \"videoBitrate\": 5000000}",
					"outputDataExample": "{\"status\": \"success\", \"outputPath\": \"/tmp/smartcut-segment-encode-0.mp4\"}"
				},
				{
					"simStepId": "30a310fd-92e7-438f-a01c-c9a4036b5155",
					"diagramNodeId": "6de31d88-03b5-4fea-880e-12c6100dce8f",
					"simStepLabel": "Smart Cut Export Flow: Store Encoded Part Path for Concatenation",
					"simStepDescription": "The file path of the newly re-encoded segment is stored in an array, preparing it for the final concatenation step.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/renderer/src/hooks/useFfmpegOperations.ts",
						"startLine": "626",
						"endLine": "626",
						"relevantVariables": [
							"smartCutSegmentsToConcat",
							"smartCutEncodedPartOutPath"
						]
					},
					"inputDataExample": "{\"path\": \"/tmp/smartcut-segment-encode-0.mp4\"}",
					"outputDataExample": "{\"path\": \"/tmp/smartcut-segment-encode-0.mp4\"}"
				},
				{
					"simStepId": "24287a8e-add7-4e4f-b90b-a0a9e2df2f9e",
					"diagramNodeId": "055c17d0-6a17-4110-a72a-cfb086a41b48",
					"simStepLabel": "Smart Cut Export Flow: Losslessly Cut Remaining 'Lossless' Part",
					"simStepDescription": "The main, larger portion of the video segment, starting from the keyframe, is cut losslessly. This is a very fast operation as it involves no re-encoding, just copying data.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/renderer/src/hooks/useFfmpegOperations.ts",
						"startLine": "617",
						"endLine": "620",
						"relevantVariables": [
							"losslessCutSingle",
							"losslessCutFrom",
							"losslessPartOutPath"
						]
					},
					"inputDataExample": "{\"from\": 12.0, \"to\": 25.0, \"outPath\": \"/tmp/smartcut-segment-copy-0.mp4\", \"keyframeCut\": true}",
					"outputDataExample": "{\"status\": \"success\", \"outputPath\": \"/tmp/smartcut-segment-copy-0.mp4\"}"
				},
				{
					"simStepId": "20514b2f-9df9-40d1-aa88-96acaaaa838f",
					"diagramNodeId": "1d541c6d-8757-4f20-9362-dc59553e851b",
					"simStepLabel": "Smart Cut Export Flow: Store Lossless Part Path for Concatenation",
					"simStepDescription": "The file path of the losslessly cut segment is added to the array of files that will be merged to create the final output.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/renderer/src/hooks/useFfmpegOperations.ts",
						"startLine": "626",
						"endLine": "626",
						"relevantVariables": [
							"smartCutSegmentsToConcat",
							"losslessPartOutPath"
						]
					},
					"inputDataExample": "{\"paths\": [\"/tmp/smartcut-segment-encode-0.mp4\", \"/tmp/smartcut-segment-copy-0.mp4\"]}",
					"outputDataExample": "{\"paths\": [\"/tmp/smartcut-segment-encode-0.mp4\", \"/tmp/smartcut-segment-copy-0.mp4\"]}"
				},
				{
					"simStepId": "e9a7b973-1a32-43be-a3ee-adc8290af84f",
					"diagramNodeId": "cafa286a-9197-4971-bdc0-34ecaf73d961",
					"simStepLabel": "Smart Cut Export Flow: Concatenate Smart and Lossless Parts",
					"simStepDescription": "The re-encoded 'smart' part and the 'lossless' part are concatenated into a single, seamless video file. This final file has the exact start time the user requested while retaining the original quality for the majority of its duration.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/renderer/src/hooks/useFfmpegOperations.ts",
						"startLine": "638",
						"endLine": "640",
						"relevantVariables": [
							"concatFiles",
							"smartCutSegmentsToConcat",
							"finalOutPath"
						]
					},
					"inputDataExample": "{\"paths\": [\"/tmp/smartcut-segment-encode-0.mp4\", \"/tmp/smartcut-segment-copy-0.mp4\"], \"outPath\": \"/path/to/output/final-cut.mp4\"}",
					"outputDataExample": "{\"path\": \"/path/to/output/final-cut.mp4\", \"created\": true}"
				},
				{
					"simStepId": "40c0329b-4cc6-4e32-96e0-a680f731042f",
					"diagramNodeId": "f90a7039-9691-47c0-b0a2-e09eb1b5c76f",
					"simStepLabel": "Smart Cut Export Flow: Return Final File Path",
					"simStepDescription": "After successful concatenation, the path to the final output file is returned, signaling the completion of the smart cut operation for the segment.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/renderer/src/hooks/useFfmpegOperations.ts",
						"startLine": "640",
						"endLine": "640",
						"relevantVariables": [
							"finalOutPath"
						]
					},
					"inputDataExample": "{\"path\": \"/path/to/output/final-cut.mp4\", \"created\": true}",
					"outputDataExample": "{\"path\": \"/path/to/output/final-cut.mp4\", \"created\": true}"
				},
				{
					"simStepId": "79ea4dee-ac93-4895-a6ac-837bd535a392",
					"diagramNodeId": "71364934-4d5f-4b50-a40d-fa048e763548",
					"simStepLabel": "Smart Cut Export Flow: Clean Up Temporary Files",
					"simStepDescription": "After the final file has been created, the temporary encoded and lossless parts are deleted from the filesystem to free up space.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/renderer/src/hooks/useFfmpegOperations.ts",
						"startLine": "641",
						"endLine": "643",
						"relevantVariables": [
							"tryDeleteFiles",
							"smartCutSegmentsToConcat"
						]
					},
					"inputDataExample": "{\"filesToDelete\": [\"/tmp/smartcut-segment-encode-0.mp4\", \"/tmp/smartcut-segment-copy-0.mp4\"]}",
					"outputDataExample": "{\"status\": \"success\"}"
				}
			],
			"description": "<ul><li>An advanced cutting mode that combines lossless cutting with targeted re-encoding to achieve frame-accurate cuts</li><li>- Standard lossless cutting is limited to keyframes</li><li>Smart Cut overcomes this limitation</li><li>- It losslessly copies the bulk of the segment from the nearest keyframe onwards</li><li>- It then re-encodes only the small portion of the video from the desired cut point to that keyframe</li><li>- The result is a visually seamless cut at the exact frame the user wants, with almost the entire file remaining in its original quality</li></ul>",
			"simulationNodesAndEdges": {
				"e52b3a49-fe56-41fb-a33b-f383ea1f2784": {
