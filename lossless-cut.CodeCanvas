							"captureFrame",
							"captureFrames"
						]
					},
					"inputDataExample": "{\"videoPath\": \"/Users/jane/Movies/project_alpha.mp4\", \"time\": 65.123, \"outPath\": \"/Users/jane/Pictures/snapshots/project_alpha-snapshot.jpeg\", \"captureFormat\": \"jpeg\", \"quality\": 90}",
					"outputDataExample": "{\"videoPath\": \"/Users/jane/Movies/project_alpha.mp4\", \"time\": 65.123, \"outPath\": \"/Users/jane/Pictures/snapshots/project_alpha-snapshot.jpeg\", \"captureFormat\": \"jpeg\", \"quality\": 90}"
				},
				{
					"simStepId": "08b918d7-4a58-4cbd-b330-348aa40064d3",
					"diagramNodeId": "97f3b177-e726-49da-bff6-4a78c01cec27",
					"simStepLabel": "Construct and Execute FFmpeg Command",
					"simStepDescription": "In the main process, the 'captureFrames' function (or a similar single-frame equivalent) receives the data. It constructs the precise command-line arguments for the ffmpeg executable, including input file, output path template, quality options, and filters. It then spawns the ffmpeg process to create the image file.",
					"isEdge": 0,
					"sourceCodeMapping": {
