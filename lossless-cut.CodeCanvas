					"outputDataExample": "{\"uiElement\": \"Rendered list of batch files in the side panel\"}"
				},
				{
					"simStepId": "e42412db-6f67-4d3c-8713-9dc4ba3939bb",
					"diagramNodeId": "1c16a6c0-13ce-471c-9b3b-9880d1aa1fb3",
					"simStepLabel": "Batch Processing Flow: User Event Triggers Concatenation",
					"simStepDescription": "The user clicks the 'Merge files' button in the rendered list. This triggers the `onMergeFilesClick` callback, which is mapped to the `concatBatch` function in the parent `App` component.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/renderer/src/App.tsx",
						"startLine": "2554",
						"endLine": "2554",
