					"outputDataExample": "{\"filePath\": \"/Users/jane/Movies/project_alpha.mp4\", \"currentTime\": 65.123, \"customOutDir\": \"/Users/jane/Pictures/snapshots\", \"captureFormat\": \"jpeg\", \"captureFrameQuality\": 90}"
				},
				{
