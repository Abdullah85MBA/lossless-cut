					"inputDataExample": "{\"stdout\": \"\", \"stderr\": \"ffmpeg version ...\", \"exitCode\": 0, \"killed\": false}",
					"outputDataExample": "{\"stdout\": \"\", \"stderr\": \"ffmpeg version ...\", \"exitCode\": 0, \"killed\": false}"
				},
				{
