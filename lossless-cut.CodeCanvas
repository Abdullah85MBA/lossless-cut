							"getCodecOpts",
							"runFfmpegWithProgress"
						]
					},
					"inputDataExample": "{\"videoPath\": \"/Users/jane/Movies/project_alpha.mp4\", \"time\": 65.123, \"outPath\": \"/Users/jane/Pictures/snapshots/project_alpha-snapshot.jpeg\", \"captureFormat\": \"jpeg\", \"quality\": 90}",
					"outputDataExample": "[\"-ss\", \"65.123\", \"-i\", \"/Users/jane/Movies/project_alpha.mp4\", \"-vframes\", \"1\", \"-q:v\", \"2\", \"/Users/jane/Pictures/snapshots/project_alpha-snapshot.jpeg\"]"
				},
				{
					"simStepId": "10c96f2b-56aa-4c61-b2d7-22d15213ac89",
					"diagramNodeId": "2e00abdb-980b-4c81-b1ef-527ae5b00720",
					"simStepLabel": "Return Result to Renderer",
					"simStepDescription": "Once the ffmpeg process successfully creates the snapshot on the file system, the main process function completes and returns the full path of the newly created image file back to the renderer process.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/renderer/src/hooks/useFrameCapture.ts",
						"startLine": "127",
