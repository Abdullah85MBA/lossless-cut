					"diagramNodeId": "a3cb6ae5-a6df-44f2-8124-9b22be48d98d",
					"simStepLabel": "Batch Processing Flow: Propagate State to BatchFilesList Component",
					"simStepDescription": "The updated `batchFiles` state is passed as a prop from the main `App` component to the `BatchFilesList` component for rendering.",
					"isEdge": 1,
