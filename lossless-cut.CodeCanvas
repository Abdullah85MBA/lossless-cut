					"diagramNodeId": "c36adbc0-7159-4b59-8635-4e2f4bbb3b2c",
					"simStepLabel": "Render Tag Editor",
					"simStepDescription": "The `EditFileDialog` component renders the `TagEditor`, passing existing metadata tags from the file and any custom tags from the application state.",
					"isEdge": 0,
					"sourceCodeMapping": {
