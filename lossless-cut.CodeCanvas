		"src/renderer/src/util/streams.ts-simstep-8ebedb99-74e0-4dde-af89-19bbaaf12f7c": {
			"path": "src/renderer/src/util/streams.ts-simstep-8ebedb99-74e0-4dde-af89-19bbaaf12f7c",
			"fileName": "streams.ts",
			"wiki": "The export logic calls helper functions to determine how each stream should be handled. Based on the target `outFormat`, it decides whether a stream can be directly copied (`-c copy`) or needs to be re-encoded to a compatible codec (e.g., converting mov_text subtitles to srt for a Matroska container).",
			"cellName": "Determine Stream Handling for New Container - streams.ts:L122-170",
			"cellId": "045068fd-d4a9-48b1-a694-665dbd4b09a4",
			"visible": true,
			"startLine": 122,
			"endLine": 170,
			"parentCellId": "b223ba8c-1baf-4abb-b9e3-b47b71c73a77",
			"parentPath": "src/renderer/src/util/streams.ts",
			"simSteps": [
