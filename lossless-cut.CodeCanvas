		"src/renderer/src/hooks/useFfmpegOperations.ts-simstep-62349804-6067-4933-a2ad-46da3411ea51": {
			"path": "src/renderer/src/hooks/useFfmpegOperations.ts-simstep-62349804-6067-4933-a2ad-46da3411ea51",
			"fileName": "useFfmpegOperations.ts",
			"wiki": "The `losslessCutSingle` function (called by `cutMultiple`) constructs the final array of FFmpeg arguments. It combines input file paths, stream mappings, and crucially, adds the `-f` flag followed by the user-selected `outFormat` to explicitly set the output container format.",
			"cellName": "Assemble Final FFmpeg Command - useFfmpegOperations.ts:L406-414",
			"cellId": "a3ee4c4d-b606-404f-8dab-26546cb1e6b3",
