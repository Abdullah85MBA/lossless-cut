					"outputDataExample": "{\"ffmpeg_command\": [\"ffmpeg\", \"-i\", \"/path/to/media/file.mp4\", \"-c\", \"copy\", \"-metadata\", \"title=My Custom Title\", \"-metadata\", \"comment=A new comment\", \"/path/to/output/file.mp4\"]}"
