					"diagramNodeId": "13db8233-e489-4c89-859c-b651965439ef",
					"simStepLabel": "User Modifies Metadata Tag",
					"simStepDescription": "The user modifies a metadata tag (e.g., adds a 'comment' tag). This triggers the `onTagsChange` callback in the `TagEditor`.",
					"isEdge": 1,
