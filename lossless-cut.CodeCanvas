					"simulationKey": "Remux media into a different container format",
					"simStepId": "8ebedb99-74e0-4dde-af89-19bbaaf12f7c"
				}
			]
		},
		"a3ee4c4d-b606-404f-8dab-26546cb1e6b3": {
			"path": "a3ee4c4d-b606-404f-8dab-26546cb1e6b3",
			"cellName": "Assemble Final FFmpeg Command - useFfmpegOperations.ts:L406-414",
