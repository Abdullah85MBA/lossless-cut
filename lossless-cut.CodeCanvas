	"simulations": {
		"Lossless cutting and trimming of video/audio files": {
			"name": "Lossless cutting and trimming of video/audio files",
			"simSteps": [
				{
					"simStepId": "040f732a-eaa0-4fe6-a765-9552316209a8",
					"diagramNodeId": "95f63a4d-75f5-45e4-82c9-35f82e905584",
					"simStepLabel": "Initiate Export Process",
					"simStepDescription": "The user clicks the 'Export' button in the UI, which triggers the `onExportPress` function. This function serves as the entry point for the entire lossless cutting workflow, first checking if an export confirmation dialog should be shown.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/renderer/src/App.tsx",
						"startLine": "1252",
						"endLine": "1253",
						"relevantVariables": [
							"onExportPress"
						]
					},
					"inputDataExample": "{\"event\": \"user_click\"}",
					"outputDataExample": "{\"filePath\": \"/Users/john/Movies/drone_footage.mp4\", \"exportConfirmEnabled\": true}"
				},
				{
					"simStepId": "811ddc50-ed22-433d-8e84-d9e94f71b2ab",
					"diagramNodeId": "a08f6bc8-cb53-48cb-8521-618f934420a2",
					"simStepLabel": "Gathering Export Configuration",
					"simStepDescription": "After confirmation, the application gathers all necessary data for the export, including the segments to be exported, output directory, file format, and other settings. This configuration object is then passed to the core `cutMultiple` function.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/renderer/src/App.tsx",
						"startLine": "1115",
						"endLine": "1120",
						"relevantVariables": [
							"cutMultiple",
							"segmentsToExport",
							"outputDir",
							"fileFormat",
							"keyframeCut"
						]
					},
					"inputDataExample": "{\"outputDir\": \"/Users/john/Documents/Cuts\", \"customOutDir\": null, \"outFormat\": \"mp4\", \"segmentsToExport\": [{\"start\": 10.5, \"end\": 25.2, \"name\": \"Segment 1\"}, {\"start\": 50.1, \"end\": 65.8, \"name\": \"Segment 2\"}], \"keyframeCut\": true, \"preserveMetadata\": true}",
					"outputDataExample": "{\"outputDir\": \"/Users/john/Documents/Cuts\", \"customOutDir\": null, \"outFormat\": \"mp4\", \"segmentsToExport\": [{\"start\": 10.5, \"end\": 25.2, \"name\": \"Segment 1\"}, {\"start\": 50.1, \"end\": 65.8, \"name\": \"Segment 2\"}], \"keyframeCut\": true, \"preserveMetadata\": true}"
				},
				{
					"simStepId": "8856211c-ebcb-4902-be96-276150131db2",
					"diagramNodeId": "4aaf6cf7-f095-4a52-af44-73e4eb9e5f09",
					"simStepLabel": "Orchestrate Multi-Segment Cutting",
					"simStepDescription": "The `cutMultiple` function in the `useFfmpegOperations` hook receives the export configuration. It iterates through each segment and calls an inner `cutSegment` function to process them concurrently.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/renderer/src/hooks/useFfmpegOperations.ts",
						"startLine": "482",
						"endLine": "488",
						"relevantVariables": [
							"cutMultiple",
							"segmentsIn",
							"outSegFileNames"
						]
					},
					"inputDataExample": "{\"outputDir\": \"/Users/john/Documents/Cuts\", \"customOutDir\": null, \"outFormat\": \"mp4\", \"segments\": [{\"start\": 10.5, \"end\": 25.2, \"name\": \"Segment 1\"}, {\"start\": 50.1, \"end\": 65.8, \"name\": \"Segment 2\"}], \"keyframeCut\": true, \"preserveMetadata\": true}",
					"outputDataExample": "{\"segment\": {\"start\": 10.5, \"end\": 25.2}, \"index\": 0, \"outPath\": \"/Users/john/Documents/Cuts/drone_footage-Segment 1.mp4\"}"
				},
				{
					"simStepId": "4aebb86d-d771-4115-8f1d-24f5531f6cb9",
					"diagramNodeId": "68efedc9-a45b-46af-99cc-2c1579c70125",
					"simStepLabel": "Passing Single Segment to Cutter",
					"simStepDescription": "Inside `cutMultiple`, the `pMap` function passes a single segment's data to the `cutSegment` helper function, which then prepares to call `losslessCutSingle` for the actual cutting operation.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/renderer/src/hooks/useFfmpegOperations.ts",
						"startLine": "648",
						"endLine": "648",
						"relevantVariables": [
							"pMap",
							"segments",
							"cutSegment"
						]
					},
					"inputDataExample": "{\"start\": 10.5, \"end\": 25.2}",
					"outputDataExample": "{\"start\": 10.5, \"end\": 25.2}"
				},
				{
					"simStepId": "45e04a60-cece-4dad-91de-b2a89d8d6269",
					"diagramNodeId": "6cd1229c-d861-4931-9330-fac7a8e843b7",
					"simStepLabel": "Process Single Segment Cut",
					"simStepDescription": "The `cutSegment` function determines this is a simple lossless cut (not a 'smart cut') and calls `losslessCutSingle`. This function is responsible for generating the specific FFmpeg command for this one segment.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/renderer/src/hooks/useFfmpegOperations.ts",
						"startLine": "542",
						"endLine": "546",
						"relevantVariables": [
							"losslessCutSingle",
							"desiredCutFrom",
							"cutTo",
							"finalOutPath"
						]
					},
					"inputDataExample": "{\"cutFrom\": 10.5, \"cutTo\": 25.2, \"outPath\": \"/Users/john/Documents/Cuts/drone_footage-Segment 1.mp4\", \"keyframeCut\": true, \"outFormat\": \"mp4\"}",
					"outputDataExample": "{\"ffmpegArgs\": [\"-hide_banner\", \"-ss\", \"10.5\", \"-i\", \"/Users/john/Movies/drone_footage.mp4\", \"-t\", \"14.7\", \"-c\", \"copy\", \"-map\", \"0\", \"/Users/john/Documents/Cuts/drone_footage-Segment 1.mp4\"]}"
				},
				{
					"simStepId": "66d47b7d-d9cf-47e2-aec7-f850054ede90",
					"diagramNodeId": "71c0eccb-a747-46e8-9e30-30d7e318485d",
					"simStepLabel": "Execute FFmpeg Command",
					"simStepDescription": "The `losslessCutSingle` function calls `runFfmpeg` to execute the generated command arguments. This starts the external `ffmpeg` process which performs the actual file cutting operation on the disk.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/renderer/src/hooks/useFfmpegOperations.ts",
						"startLine": "480",
						"endLine": "481",
						"relevantVariables": [
							"runFfmpeg",
							"ffmpegArgs"
						]
					},
					"inputDataExample": "{\"ffmpegArgs\": [\"-hide_banner\", \"-ss\", \"10.5\", \"-i\", \"/Users/john/Movies/drone_footage.mp4\", \"-t\", \"14.7\", \"-c\", \"copy\", \"-map\", \"0\", \"/Users/john/Documents/Cuts/drone_footage-Segment 1.mp4\"]}",
					"outputDataExample": "{\"ffmpegArgs\": [\"-hide_banner\", \"-ss\", \"10.5\", \"-i\", \"/Users/john/Movies/drone_footage.mp4\", \"-t\", \"14.7\", \"-c\", \"copy\", \"-map\", \"0\", \"/Users/john/Documents/Cuts/drone_footage-Segment 1.mp4\"]}"
				},
				{
					"simStepId": "86be672e-fb78-4b18-bb45-ebfd7a95356c",
					"diagramNodeId": "f1bb278f-ef77-481f-b192-7019777d2473",
					"simStepLabel": "Return Processed File Paths",
					"simStepDescription": "After `ffmpeg` finishes processing a segment, `cutSegment` returns an object containing the path to the newly created output file. `cutMultiple` collects these results for all segments.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/renderer/src/hooks/useFfmpegOperations.ts",
						"startLine": "648",
						"endLine": "648",
						"relevantVariables": [
							"pMap"
						]
					},
					"inputDataExample": "{\"processExitCode\": 0, \"stdout\": \"\", \"stderr\": \"ffmpeg output...\"}",
					"outputDataExample": "{\"outFiles\": [{\"path\": \"/Users/john/Documents/Cuts/drone_footage-Segment 1.mp4\", \"created\": true}, {\"path\": \"/Users/john/Documents/Cuts/drone_footage-Segment 2.mp4\", \"created\": true}]}"
				},
				{
					"simStepId": "51672d20-3e79-4560-b56c-90f9d363a69c",
					"diagramNodeId": "f1f812ac-689e-4f33-bcd7-d354e39fcf37",
					"simStepLabel": "Transmit Results for Finalization",
					"simStepDescription": "The resulting array of created file paths is passed back from `cutMultiple` to the `onExportConfirmed` function in `App.tsx`.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/renderer/src/App.tsx",
						"startLine": "1115",
						"endLine": "1115",
						"relevantVariables": [
							"outFiles"
						]
					},
					"inputDataExample": "{\"outFiles\": [{\"path\": \"/Users/john/Documents/Cuts/drone_footage-Segment 1.mp4\", \"created\": true}, {\"path\": \"/Users/john/Documents/Cuts/drone_footage-Segment 2.mp4\", \"created\": true}]}",
					"outputDataExample": "{\"outFiles\": [{\"path\": \"/Users/john/Documents/Cuts/drone_footage-Segment 1.mp4\", \"created\": true}, {\"path\": \"/Users/john/Documents/Cuts/drone_footage-Segment 2.mp4\", \"created\": true}]}"
				},
				{
					"simStepId": "304ea900-53b9-40cb-b9e4-7b36c8de4642",
					"diagramNodeId": "c57ad023-8317-41a2-a48c-61de0d1590b0",
					"simStepLabel": "Handle Export Completion",
					"simStepDescription": "The `onExportConfirmed` function in `App.tsx` receives the list of created files. It then enters the `finally` block to reset the application's working state and hide the progress indicator, concluding the operation.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/renderer/src/App.tsx",
						"startLine": "1242",
						"endLine": "1245",
						"relevantVariables": [
							"setWorking",
							"setProgress"
						]
					},
					"inputDataExample": "{\"outFiles\": [{\"path\": \"/Users/john/Documents/Cuts/drone_footage-Segment 1.mp4\", \"created\": true}, {\"path\": \"/Users/john/Documents/Cuts/drone_footage-Segment 2.mp4\", \"created\": true}]}",
					"outputDataExample": "{\"status\": \"success\", \"message\": \"Export completed for 2 files.\", \"working\": false, \"progress\": null}"
				}
			],
			"description": "<ul><li>The core feature of the application, allowing users to cut or trim parts of media files without re-encoding, preserving the original quality</li><li>- Users can set start and end points for multiple segments on a visual timeline</li><li>- Segments can be exported as individual files or merged into a single file</li><li>- This process is extremely fast as it performs a direct data copy of the selected portions</li><li>- It supports 'inverting' the selection, which removes the selected segments and keeps the rest</li></ul>",
			"simulationNodesAndEdges": {
				"95f63a4d-75f5-45e4-82c9-35f82e905584": {
