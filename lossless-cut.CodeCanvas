							"showOsNotification",
							"openDirToast"
						]
					},
					"inputDataExample": "{\"outPath\": \"/Users/jane/Pictures/snapshots/project_alpha-snapshot.jpeg\"}",
					"outputDataExample": "{}"
				}
			],
			"description": "<ul><li>Allows users to take full-resolution snapshots from a video at any point in time</li><li>- Snapshots can be saved in JPEG or PNG format with adjustable quality</li><li>- It's also possible to export a range of video frames as a sequence of images</li><li>- Frame export can be configured to capture every nth frame, every second, or based on scene changes</li><li>- This is useful for creating thumbnails, GIFs, or for detailed frame-by-frame analysis</li></ul>",
