					"diagramNodeId": "6fb00c7b-b88b-4cfe-b7e7-24034676403b",
					"simStepLabel": "Batch Processing Flow: Open System Directory Dialog",
					"simStepDescription": "The `openDirDialog` function in the renderer process is executed in response to the IPC message. It calls the Electron `showOpenDialog` API to display a native dialog, allowing the user to select a directory.",
					"isEdge": 0,
					"sourceCodeMapping": {
