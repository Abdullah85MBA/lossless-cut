					"outputDataExample": "{\"eventType\": \"onClick\"}"
				},
				{
					"simStepId": "6168cd50-ae66-4bc2-8a86-d484086f071c",
					"diagramNodeId": "7a9beac2-f517-416e-b860-8491e9ecbca4",
					"simStepLabel": "Batch Processing Flow: Prepare for Concatenation",
					"simStepDescription": "The `concatBatch` function is executed. It validates that there are at least two files to merge and then prepares to open the `ConcatDialog` to gather final user confirmation and settings for merging the files.",
					"isEdge": 0,
