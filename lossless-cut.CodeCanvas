							"mainWindow.webContents.send"
						]
					},
					"inputDataExample": "{\"userAction\": \"Click on File -> Open folder menu item\"}",
					"outputDataExample": "{\"ipcMessage\": \"openDirDialog\"}"
				},
				{
					"simStepId": "bebd87f4-6d93-4e22-aee8-25b8426aa711",
					"diagramNodeId": "7a76fc79-db73-4ae4-937f-8b406ee51ba1",
					"simStepLabel": "Batch Processing Flow: IPC Message from Main to Renderer",
					"simStepDescription": "The main process sends an 'openDirDialog' message to the renderer process to instruct it to open the directory selection dialog.",
					"isEdge": 1,
					"sourceCodeMapping": {
