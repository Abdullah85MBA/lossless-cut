		"045068fd-d4a9-48b1-a694-665dbd4b09a4": {
			"path": "045068fd-d4a9-48b1-a694-665dbd4b09a4",
			"cellName": "Determine Stream Handling for New Container - streams.ts:L122-170",
			"cellId": "045068fd-d4a9-48b1-a694-665dbd4b09a4",
			"visible": true,
			"parentCellId": "b223ba8c-1baf-4abb-b9e3-b47b71c73a77"
