					"inputDataExample": "{\"existingTags\": {\"creation_time\": \"2023-10-27T10:00:00.000000Z\"}, \"customTags\": {\"title\": \"My Custom Title\"}, \"editingFile\": \"/path/to/media/file.mp4\"}",
					"outputDataExample": "{\"existingTags\": {\"creation_time\": \"2023-10-27T10:00:00.000000Z\"}, \"customTags\": {\"title\": \"My Custom Title\"}}"
				},
				{
