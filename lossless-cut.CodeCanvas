					},
					"inputDataExample": "{\"filePath\": \"/Users/jane/Movies/project_alpha.mp4\", \"currentTime\": 65.123, \"customOutDir\": \"/Users/jane/Pictures/snapshots\", \"captureFormat\": \"jpeg\", \"captureFrameQuality\": 90}",
					"outputDataExample": "{\"videoPath\": \"/Users/jane/Movies/project_alpha.mp4\", \"time\": 65.123, \"outPath\": \"/Users/jane/Pictures/snapshots/project_alpha-snapshot.jpeg\", \"captureFormat\": \"jpeg\", \"quality\": 90}"
				},
				{
					"simStepId": "9eed8b7c-b8d8-4dea-a421-e548b99249ec",
					"diagramNodeId": "57f4c0d3-6320-4a51-b443-f54cf41087ae",
					"simStepLabel": "Renderer-to-Main IPC Call",
					"simStepDescription": "A bridge file in the renderer process calls the 'captureFrame' function. This function is exposed from the main process using Electron's remote/IPC mechanism, effectively crossing the process boundary to where Node.js and ffmpeg can be executed.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/renderer/src/ffmpeg.ts",
						"startLine": "15",
						"endLine": "21",
						"relevantVariables": [
