					"diagramNodeId": "76588c3d-6642-4ec4-8fed-76c3780ebce0",
					"simStepLabel": "Batch Processing Flow: Pass Selected Paths to File Handler",
					"simStepDescription": "The array of selected directory paths is passed to the `userOpenFiles` function to be processed and loaded into the application's state.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/renderer/src/App.tsx",
						"startLine": "1935",
						"endLine": "1935",
						"relevantVariables": [
