		"Batch processing of multiple files": {
			"name": "Batch processing of multiple files",
			"simSteps": [
				{
					"simStepId": "bea0a727-2783-4a42-9e5e-15ff6b283b65",
					"diagramNodeId": "b9ceabff-ba45-4e8e-8fd7-668c4847bdbb",
					"simStepLabel": "Batch Processing Flow: User Initiates 'Open Folder'",
					"simStepDescription": "The user selects 'Open folder' from the File menu. This action is handled by the main process, which is configured to send an IPC message to the renderer process to trigger the system's file dialog.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/main/menu.ts",
						"startLine": "35",
						"endLine": "38",
						"relevantVariables": [
