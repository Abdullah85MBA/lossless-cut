						]
					},
					"inputDataExample": "{\"batchFiles\": [{\"path\": \"/Users/jane/Movies/Vacation/Day1/vid1.mp4\", \"name\": \"vid1.mp4\"}, {\"path\": \"/Users/jane/Movies/Vacation/Day1/vid2.mp4\", \"name\": \"vid2.mp4\"}]}",
					"outputDataExample": "{\"batchFiles\": [{\"path\": \"/Users/jane/Movies/Vacation/Day1/vid1.mp4\", \"name\": \"vid1.mp4\"}, {\"path\": \"/Users/jane/Movies/Vacation/Day1/vid2.mp4\", \"name\": \"vid2.mp4\"}]}"
